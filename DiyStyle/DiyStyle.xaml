    <!-- 最简单圆形滑块样式 -->
    <Style x:Key="SimpleRoundSlider" TargetType="Slider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <!-- 轨道 -->
                        <Border Height="4" Background="White" CornerRadius="2" VerticalAlignment="Center"/>
                        <!-- 填充 -->
                        <Border Height="4" Background="#22C55E" CornerRadius="2" HorizontalAlignment="Left" 
                            Width="{TemplateBinding Value, Converter={StaticResource ProgressToWidthConverter}}"
                            VerticalAlignment="Center"/>
                        <!-- 圆形滑块 -->
                        <Track Name="PART_Track">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="16" Height="16" Fill="White" Stroke="#D1D5DB"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

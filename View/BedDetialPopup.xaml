<UserControl x:Class="WarmBox_Central_Monitoring_Station.View.BedDetialPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WarmBox_Central_Monitoring_Station.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary Source="/DiyStyle/Diystyle.xaml"/>
    </UserControl.Resources>
    <Border BorderBrush="Gray" BorderThickness="0.5">
        <Grid VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 标题栏：显示床位信息 + 返回按钮 -->
            <Border Grid.Row="0" Background="#404042" Padding="10,5,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="White" FontWeight="Bold" FontSize="16" Padding="0,5">
                 <Run Text="{Binding Bed.BedNumber}" />
                 <Run Text=" " />
                 <Run Text="{Binding Bed.DeviceName}" />
                 <Run Text="{Binding Bed.PatientNameForDisplay, Mode=OneWay}" />
                 <Run Text="|" />
                 <Run Text="{Binding Bed.Sex}" />
                 <Run Text="|" />
                 <Run Text="{Binding Bed.PatientOld}" />
                 <Run Text="天" />
                 <Run Text="|" />
                 <Run Text="胎龄" />
                 <Run Text="{Binding Bed.PatientTaiLing}" />
                 <Run Text="周" />
                    </TextBlock>
                    <Grid Grid.Column="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Margin="10,0" Background="#4F4F52" Padding="10,0">
                                <TextBlock                           
                             FontSize="16"
                             FontWeight="Bold"
                             Foreground="#22C55E" 
                             VerticalAlignment="Center"
                              HorizontalAlignment="Center">
                                <Run Text="起搏:"/>
                                <Run Text="{Binding Bed.Qibo}"/>
                                </TextBlock>
                            </Border>
                            <Grid Width="40"/>
                            <!--<Button Style="{StaticResource IconButtonStyle_xq}"
                          Content="设备故障"
                          Tag="/IMG/new/jg.png"
                          Background="#F53D3D"
                          Foreground="White"
                          FontSize="15"
                          Padding="5,5"/>-->

                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Grid.Column="2">
                        <Button Style="{StaticResource IconButtonStyle_xq}"
                    Margin="0,0,15,0"
                    Content="{DynamicResource Camera}"
                    Tag="/IMG/new/sxt.png"                             
                    Background="Transparent"
                    Foreground="White"
                    FontSize="15"
                    Command="{Binding  ShowCameraCommand}"
                    Padding="5,5"/>
                        <Button Style="{StaticResource IconButtonStyle_xq}"
                     Margin="0,0,15,0"
                     Content="{DynamicResource Print}"
                     Tag="/IMG/new/dayin.png"                             
                     Background="Transparent"
                     Foreground="White"
                     FontSize="15"
                     Command="{Binding PrintCommand}"
                     Padding="5,5"/>
                        <Button Style="{StaticResource IconButtonStyle_xq}"
                     Content="{Binding Bed.FreezeButtonText}"
                     Command="{Binding Bed.PauseWaveformCommand}"
                     Tag="/IMG/new/bofang.png"                             
                     Background="Transparent"
                     Foreground="White"
                     FontSize="15"
                     Padding="5,5"/>
                        <Button Content="{DynamicResource TrendReview}" Style="{StaticResource IconButtonStyle_xq3}" Background="#2c2c2c"  Margin="15,0,15,0" BorderBrush="Black" Command="{Binding ShowTrendReviewCommand}"></Button>
                        <Button Name="close"  Style="{StaticResource IndexbuttonStyle2}"  Command="{Binding CloseCommand}" HorizontalAlignment="Right" >
                            <Image Source="/IMG/new/fanhui.png" >
                            </Image>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区域：放置波形等详细信息 -->
            <ContentControl Grid.Row="1" x:Name="ContentControl" Content="{Binding CurrentDetailView}" 
                VerticalAlignment="Stretch" />
        </Grid>
    </Border>
</UserControl>
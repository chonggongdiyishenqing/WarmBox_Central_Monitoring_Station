<UserControl x:Class="WarmBox_Central_Monitoring_Station.View.BedDetialPopupUsercontroles.CameraConnectingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WarmBox_Central_Monitoring_Station.View.BedDetialPopupUsercontroles"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Width="400" Height="350" Background="#1E1E1E">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyStyle/Diystyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DialogButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Width" Value="120"/>
                <Setter Property="Margin" Value="10,0,0,0"/>
                <Setter Property="Background" Value="#5a5a5a"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#7a7a7a"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                        CornerRadius="3" 
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部栏：左上角关闭按钮 -->
        <Grid Grid.Row="0" Margin="2">
            <Button Name="close" Grid.Column="3" Style="{StaticResource IndexbuttonStyle2}"  Click="CloseButton_Click" HorizontalAlignment="Right" >
                <Image Source="/IMG/new/close.png" />
            </Button>
        </Grid>

        <!-- 中间内容区域 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Lottie 动画（相对路径，指向项目中的 Resource 文件） -->
            <lottie:LottieAnimationView 
                x:Name="LottieView"
                AutoPlay="True"
                Width="160" Height="160"
                ResourcePath="pack://application:,,,/IMG/Animations/camera.json"
                RepeatCount="-1" />

            <!-- 提示文字 -->
            <TextBlock Text="{DynamicResource CameraNotConnected}" 
                       Foreground="#E0E0E0"
                       FontSize="24"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>
        </StackPanel>

        <!-- 底部按钮栏：确认、取消居中 -->
        <Border Grid.Row="2" Background="#3a3a3a" Padding="15">
            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <!-- 确定按钮 -->
                <Button Grid.Column="0"
                        Content="{DynamicResource Confirm}" 
                        Style="{StaticResource DialogButtonStyle}"
                        Background="#4A90E2"
                        Foreground="White"
                        BorderBrush="#4A90E2"
                        Cursor="Hand"
                        Click="OkButton_Click"
                        />

                <!-- 取消按钮 -->
                <Button Grid.Column="1"
                        Content="{DynamicResource Cancel}" 
                        Style="{StaticResource DialogButtonStyle}"
                        Cursor="Hand"
                        Click="CancelButton_Click"
                       />
            </Grid>
        </Border>
    </Grid>
</UserControl>
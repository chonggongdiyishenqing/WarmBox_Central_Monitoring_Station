<UserControl x:Class="WarmBox_Central_Monitoring_Station.View.BedView16"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:model="clr-namespace:WarmBox_Central_Monitoring_Station.Model"
             xmlns:converters="clr-namespace:WarmBox_Central_Monitoring_Station.Converters" xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 外层 Border 负责整体闪烁 -->
    <Border x:Name="MainBorder" Margin="1" BorderThickness="2" 
            BorderBrush="#404042" Background="#404042">
        <Border.Resources>
            <!-- 高优先级：红色呼吸 -->
            <Storyboard x:Key="FlashHigh" RepeatBehavior="Forever" AutoReverse="True">
                <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                From="#FF0000" To="#440000" Duration="0:0:0.5"/>
                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                From="#FF0000" To="#440000" Duration="0:0:0.5"/>
            </Storyboard>
            <!-- 中优先级：黄色呼吸 -->
            <Storyboard x:Key="FlashMedium" RepeatBehavior="Forever" AutoReverse="True">
                <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                From="#FFD700" To="#443200" Duration="0:0:0.5"/>
                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                From="#FFD700" To="#443200" Duration="0:0:0.5"/>
            </Storyboard>
        </Border.Resources>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentAlarmPriority}" Value="High">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="FlashHighStory" 
                                             Storyboard="{StaticResource FlashHigh}"/>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <RemoveStoryboard BeginStoryboardName="FlashHighStory"/>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CurrentAlarmPriority}" Value="Medium">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="FlashMediumStory" 
                                             Storyboard="{StaticResource FlashMedium}"/>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <RemoveStoryboard BeginStoryboardName="FlashMediumStory"/>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                    <!-- 低优先级或无报警时不触发动画，恢复默认背景色 -->
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 第一行：左右布局 -->
            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：床位号 + 设备类型 + 患者姓名 -->
                <TextBlock Grid.Column="0" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="5,5,0,5">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} - {1} {2}">
                            <Binding Path="BedNumber"/>
                            <Binding Path="DeviceName"/>
                            <Binding Path="PatientNameForDisplay"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <!-- 右侧：报警信息区域 -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Right"
                        
                        Background="#2c2c2c"
                        CornerRadius="2"
                        Margin="0,5,5,5"
                        MaxWidth="200">
                    <Border Margin="3" 
            Background="#4f4f52"                 
            CornerRadius="2">
                        <!-- 使用 RunningBlock 替换原 TextBlock -->
                        <hc:RunningBlock 
                        Content="{Binding CurrentAlarm}"
          
                         Foreground="{Binding  CurrentAlarmColor}"
                         FontWeight="Bold"
                         BorderThickness="0"        
                         Height="20"                         
                         Padding="0,2,0,2" 
                         ToolTip="{Binding CurrentAlarm}" />
                    </Border>
                </Border>
            </Grid>

            <!-- 第二行：其他内容 -->
            <Border Padding="5" Grid.Row="1" Background="Black">
                <Grid>
                    <!-- 正常数据区域（在线时显示） -->
                    <Grid x:Name="NormalContent" 
              Visibility="{Binding IsOffline, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 上部：箱温、肤温、O2、工作模式等 -->
                        <Grid Grid.Row="0" Background="#1a1a1a">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3.8*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 工作模式 -->
                            <Grid Grid.Column="0" Grid.Row="0">
                                <TextBlock Text="{DynamicResource WorkMode}" Foreground="#979eab" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Column="0" Grid.Row="1">
                                <TextBlock FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Stretch" Foreground="#00a6ff">
                        <Run>
                            <Run.Text>
                                <MultiBinding StringFormat="{}{0}/{1}%">
                                    <Binding Path="WorkMode" />
                                    <Binding Path="WorkModePercent" />
                                </MultiBinding>
                            </Run.Text>
                        </Run>
                                </TextBlock>
                            </Grid>

                            <!-- 箱温 -->
                            <Grid Grid.Column="1" Grid.Row="0">
                                <TextBlock Text="{DynamicResource BoxTemp}" Foreground="#979eab" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Column="1" Grid.Row="1">
                                <TextBlock FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                        <Run Text="{Binding BoxTemp}" Foreground="#05DF72" />
                        <Run Text="℃" Foreground="#d7e0e4" FontSize="13" />
                                </TextBlock>
                            </Grid>

                            <!-- 肤温1 -->
                            <Grid Grid.Column="2" Grid.Row="0">
                                <TextBlock Text="{DynamicResource SkinTemp1}" Foreground="#979eab" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Column="2" Grid.Row="1">
                                <TextBlock FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                        <Run Text="{Binding SkinTemp1}" Foreground="#05DF72" />
                        <Run Text="℃" Foreground="#d7e0e4" FontSize="13" />
                                </TextBlock>
                            </Grid>

                            <!-- O2 -->
                            <Grid Grid.Column="3" Grid.Row="0">
                                <TextBlock Text="O2" Foreground="#979eab" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Column="3" Grid.Row="1">
                                <TextBlock FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                        <Run Text="{Binding O2}" Foreground="#05DF72" />
                        <Run Text="%" Foreground="#d7e0e4" FontSize="13" />
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1" Height="5" Background="Transparent" />

                        <!-- 下部：HR、RESP、SpO2、NIBP -->
                        <Grid Grid.Row="2" Background="#1a1a1a">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="3.4*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- HR -->
                            <Grid Grid.Column="0" Grid.Row="0">
                                <TextBlock Text="HR" Foreground="#979eab" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Column="0" Grid.Row="1">
                                <TextBlock FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                        <Run Text="{Binding HeartRate}" Foreground="#F53D3D" />
                        <Run Text="bpm" Foreground="#d7e0e4" FontSize="13" />
                                </TextBlock>
                            </Grid>

                            <!-- RESP -->
                            <Grid Grid.Column="1" Grid.Row="0">
                                <TextBlock Text="RESP" Foreground="#979eab" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Column="1" Grid.Row="1">
                                <TextBlock FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                        <Run Text="{Binding RespirationRate}" Foreground="#05DF72" />
                        <Run Text="rpm" Foreground="#d7e0e4" FontSize="13" />
                                </TextBlock>
                            </Grid>

                            <!-- SpO2 -->
                            <Grid Grid.Column="2" Grid.Row="0">
                                <TextBlock Text="SpO2" Foreground="#979eab" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Column="2" Grid.Row="1">
                                <TextBlock FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                        <Run Text="{Binding BloodOxygen}" Foreground="#05DF72" />
                        <Run Text="%" Foreground="#d7e0e4" FontSize="13" />
                                </TextBlock>
                            </Grid>

                            <!-- NIBP -->
                            <Grid Grid.Column="3" Grid.Row="0">
                                <TextBlock Text="NIBP" Foreground="#979eab" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Column="3" Grid.Row="1">
                                <TextBlock FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                        <Run Text="{Binding BloodPressure}" Foreground="#F53D3D" />
                        <Run Text="mmHg" Foreground="#d7e0e4" FontSize="13" />
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 离线覆盖区域（离线时显示） -->
                    <Grid x:Name="OfflineContent" 
              Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="/IMG/new/diannao.png" Stretch="Uniform" Width="80" Height="80" />
                            <TextBlock Text="OFFLINE" Foreground="#5a5a5b" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
<Window x:Class="WarmBox_Central_Monitoring_Station.View.IndexView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WarmBox_Central_Monitoring_Station.View"
        xmlns:converters="clr-namespace:WarmBox_Central_Monitoring_Station.Converters"
        Icon="/IMG/new/david.png"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowState="Maximized"
        Height="850" Width="1400">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyStyle/Diystyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
            <converters:ViewModeToVisibilityConverter x:Key="ViewModeToVisibilityConverter"/>
            <converters:ViewModeToButtonVisibilityConverter x:Key="ViewModeToButtonVisibilityConverter"/>
            <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:BoolToInvertVisibilityConverter x:Key="BoolToInvertVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#4d4d4e" BorderThickness="0,0,0,1.5" BorderBrush="#2C2C2C" MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="5,5">
                    <Image Source="/IMG/new/david.png" Width="40" Height="40" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0">
                    <Label Content="{DynamicResource CentralMonitor}" VerticalAlignment="Center" FontSize="24" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button Command="{Binding TogglePatientNameCommand}" Margin="0,0,12,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle2}">
                                <!-- 左右稍大内边距，保证不贴边 -->
                                <Setter Property="Content" Value="{DynamicResource PrivacyOffText}"/>
                                <Style.Triggers>
                                    <!-- 当 IsPrivacyModeEnabled 为 True 时显示“隐私：开” -->
                                    <DataTrigger Binding="{Binding IsPrivacyModeEnabled}" Value="True">
                                        <Setter Property="Content" Value="{DynamicResource PrivacyOnText}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="15,0,15,0">
                        <TextBlock Text="{DynamicResource TotalDevices}" 
               Foreground="White" 
               FontSize="18" 
               VerticalAlignment="Center"
               FontWeight="Bold"/>
                        <TextBlock Text="{Binding WarmBoxViewModel.TotalBeds}" 
               Foreground="White" 
               FontSize="18" 
               VerticalAlignment="Center"
               FontWeight="Bold"/>
                    </StackPanel>
                    <!--{Binding Bedcount}-->
                    <!-- 紧急报警部分 -->
                    <StackPanel Orientation="Horizontal" Margin="15,0,15,0">
                        <TextBlock Text="{DynamicResource Critical}" 
               Foreground="Red" 
               FontSize="18" 
               VerticalAlignment="Center"
               FontWeight="Bold"/>
                        <TextBlock Text="{Binding WarmBoxViewModel.CriticalAlarmCount}" 
               Foreground="White" 
               FontSize="18" 
               VerticalAlignment="Center"
               FontWeight="Bold"/>
                    </StackPanel>

                    <!-- 警告报警部分 -->
                    <StackPanel Orientation="Horizontal" Margin="15,0,15,0">
                        <TextBlock Text="{DynamicResource Warning}"
               Foreground="Orange" 
               FontSize="18" 
               VerticalAlignment="Center"
               FontWeight="Bold"/>
                        <TextBlock Text="{Binding WarmBoxViewModel.WarningAlarmCount}" 
               Foreground="White" 
               FontSize="18" 
               VerticalAlignment="Center"
               FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="15,0">
                        <TextBlock Text="{Binding CurrentTime}" 
               Foreground="White" 
               FontSize="20" 
               VerticalAlignment="Center"
               FontWeight="Bold"
               Margin="0,0,5,0"/>
                    </StackPanel>
                    <Button Name="wu" Style="{StaticResource IndexbuttonStyle2}" 
                      Click="MinimizeButton_Click">
                        <Image Source="/IMG/new/min.png" />
                    </Button>
                    <Button Name="min" Style="{StaticResource IndexbuttonStyle2}"  
                      Click="MaximizeButton_Click">
                        <Image Source="/IMG/new/qjfd.png" />
                    </Button>
                    <Button Name="close" Style="{StaticResource IndexbuttonStyle2}"  Command="{Binding CloseCommand}">
                        <Image Source="/IMG/new/close.png" >
                        </Image>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Background="#2C2C2C">
            <ContentControl Content="{Binding CurrentView}"/>
        </Grid>
        <Border Grid.Row="2" Background="#4d4d4e" BorderThickness="1.5,0,0,0" BorderBrush="#2C2C2C">
            <Grid>
                <!-- 重新设计列定义，让左右两侧的宽度相同，中间内容自然居中 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0.4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧视图切换按钮 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="5,5">
                    <UniformGrid Rows="1" Columns="3" Width="Auto">
                  

                        <ToggleButton x:Name="view16Button"
                 Style="{StaticResource MiddleViewModeButtonStyle}"
                 Content="{DynamicResource View16}"
                 IsChecked="{Binding SelectedViewMode, Converter={StaticResource IntToBoolConverter}, ConverterParameter=16}"
                 Command="{Binding Select16ViewCommand}"/>

                        <ToggleButton x:Name="view8Button"
                 Style="{StaticResource RightViewModeButtonStyle}"
                 Content="{DynamicResource View8}"
                 IsChecked="{Binding SelectedViewMode, Converter={StaticResource IntToBoolConverter}, ConverterParameter=8}"
                 Command="{Binding Select8ViewCommand}"/>
                    </UniformGrid>
                </StackPanel>

                <!-- 左边占位符 -->
                <Grid Grid.Column="1"/>

                <!-- 中间分页按钮 - 现在在整体Border中居中 -->
                <!-- 中间分页按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsPageNavigationVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding WarmBoxViewModel.Pages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" 
                        Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource SimplePageButtonStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 右边占位符 -->
                <Grid Grid.Column="3"/>

                <!-- 右侧其他按钮 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,5">
                    <Button Name="wu1" Style="{StaticResource IndexbuttonStyle2}" Click="wu1_Click">
                        <Image Source="/IMG/new/tixing.png" />
                    </Button>
                    <Button Name="min1" Style="{StaticResource IndexbuttonStyle2}" Click="min1_Click">
                        <Image Source="/IMG/new/set22.png" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

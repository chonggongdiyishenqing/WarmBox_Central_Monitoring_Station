<Window x:Class="WarmBox_Central_Monitoring_Station.View.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WarmBox_Central_Monitoring_Station.View"
        xmlns:helpers="clr-namespace:WarmBox_Central_Monitoring_Station.Model"
        xmlns:converters="clr-namespace:WarmBox_Central_Monitoring_Station.Converters"
        mc:Ignorable="d"
       Title="LoginView" Height="550" Width="1000"
       Icon="/IMG/new/david.png"
       ResizeMode="NoResize"
       WindowStyle="None">

    <Window.Resources>
        <converters:IsStringNotEmptyConverter x:Key="IsStringNotEmptyConverter"/>
        <!-- 输入框容器样式 -->
        <Style x:Key="LoginInputStyle" TargetType="Border">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- TextBox统一样式 -->
        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#505050"/>
            <Setter Property="SelectionOpacity" Value="0.3"/>
        </Style>

        <!-- PasswordBox统一样式 -->
        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0,10,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="White"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" 
                               Background="{TemplateBinding Background}"
                               BorderBrush="{TemplateBinding BorderBrush}"
                               BorderThickness="{TemplateBinding BorderThickness}"
                               CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                         Margin="{TemplateBinding Padding}"
                                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                         HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 提示文本统一触发器样式 -->
        <Style x:Key="PasswordPlaceholderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <!-- 当密码框没有焦点且密码为空时显示 -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ElementName=PasswordBox, Path=IsFocused}" Value="False"/>
                        <Condition Binding="{Binding Path=(helpers:PasswordBoxHelper.BoundPassword), ElementName=PasswordBox, Converter={StaticResource IsStringNotEmptyConverter}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 图标样式 -->
        <Style x:Key="InputIconStyle" TargetType="Image">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- 背景图片 -->
        <Grid.Background>
            <ImageBrush ImageSource="/IMG/new/beijing.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- 退出按钮 -->
        <Button x:Name="ExitButton" 
             HorizontalAlignment="Right" 
             VerticalAlignment="Top"
             Margin="0,10,20,0"
             Width="70" 
             Height="25"
             BorderThickness="0"
             Cursor="Hand"
             Command="{Binding ExitCommand}">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#66AAAAAA" Offset="0"/>
                    <GradientStop Color="#33AAAAAA" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="退出" Foreground="White" FontSize="12" FontWeight="Medium" Opacity="0.9"/>
            </StackPanel>
        </Button>

        <!-- Logo和标题 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" 
                 Orientation="Horizontal" MouseLeftButtonDown="TitlePanel_MouseLeftButtonDown">
            <Image Source="/IMG/new/david.png" Width="50" Height="50" VerticalAlignment="Center"/>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="10,0,0,0">
                <Label x:Name="TitleLabel" Content="戴维中央监护站" VerticalAlignment="Center"
                    FontSize="26" Foreground="White" FontWeight="Bold" Padding="0"/>
                <Border Height="2" Width="{Binding ActualWidth, ElementName=TitleLabel}"
                     Background="#808080" Margin="0,2,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
        </StackPanel>

        <!-- 登录框容器 -->
        <Border Margin="100,100,100,20" Background="#10000000" CornerRadius="2">
            <Grid Width="550" Height="320">
                <!-- 完整的外边框 -->
                <Border BorderBrush="#808080" BorderThickness="2" CornerRadius="0">
                    <!-- 顶部装饰线 -->
                    <Grid>
                        <Rectangle Height="4" HorizontalAlignment="Center" Width="250" VerticalAlignment="Top">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#808080" Offset="0"/>
                                    <GradientStop Color="#E0E0E0" Offset="0.3"/>
                                    <GradientStop Color="White" Offset="0.5"/>
                                    <GradientStop Color="#E0E0E0" Offset="0.7"/>
                                    <GradientStop Color="#808080" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Border>

                <!-- 登录表单内容 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1">
                    <TextBlock Text="用户登录" FontSize="28" FontWeight="Bold" 
                            Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <!-- 用户名输入框 - 使用统一的样式 -->
                    <Border Style="{StaticResource LoginInputStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 用户图标 -->
                            <Image Source="/IMG/new/user_login.png" Style="{StaticResource InputIconStyle}" Grid.Column="0"/>

                            <!-- 用户名输入框 -->
                            <TextBox x:Name="UsernameTextBox" 
                                  Style="{StaticResource LoginTextBoxStyle}"
                                  Grid.Column="1"
                                  GotFocus="UsernameTextBox_GotFocus"
                                  LostFocus="UsernameTextBox_LostFocus"
                                  Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=请输入账号}"/>
                        </Grid>
                    </Border>

                    <!-- 密码输入框 - 使用统一的样式 -->
                    <Border Style="{StaticResource LoginInputStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 锁图标 -->
                            <Image Source="/IMG/new/password_login.png" Style="{StaticResource InputIconStyle}" Grid.Column="0"/>

                            <!-- 密码输入框 -->
                            <PasswordBox x:Name="PasswordBox" 
                                      Style="{StaticResource LoginPasswordBoxStyle}"
                                      Grid.Column="1"
                                      GotFocus="PasswordBox_GotFocus"
                                      LostFocus="PasswordBox_LostFocus"
                                      helpers:PasswordBoxHelper.BindPassword="true"
                                      helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- 密码提示文字 - 使用统一的样式 -->
                            <TextBlock x:Name="PasswordPlaceholder" 
                                    Text="请输入密码" 
                                    Style="{StaticResource PasswordPlaceholderStyle}"
                                    Grid.Column="1"/>
                        </Grid>
                    </Border>

                    <!-- 记住密码选项 -->
                    <CheckBox x:Name="RememberPasswordCheckBox" 
                           Content="记住密码" 
                           Foreground="#DDDDDD" 
                           FontSize="14" 
                           Margin="0,0,0,15"
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center"
                           IsChecked="{Binding RememberPassword}"/>

                    <!-- 登录按钮 -->
                    <Button Content="登录" 
                         Width="300" 
                         Height="40" 
                         Background="#505050" 
                         Foreground="White"
                         FontSize="16" 
                         FontWeight="Bold" 
                         BorderThickness="0" 
                         Cursor="Hand"
                         HorizontalAlignment="Center" 
                         Margin="0,10,0,0"     
                         Command="{Binding LoginCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

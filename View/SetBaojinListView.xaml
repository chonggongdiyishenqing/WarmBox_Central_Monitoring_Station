<Window x:Class="WarmBox_Central_Monitoring_Station.View.SetBaojinListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WarmBox_Central_Monitoring_Station.View"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        Title="报警列表" Height="960" Width="1100">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyStyle/Diystyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Storyboard x:Key="ScaleFromPointStoryboard">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.1" To="1" Duration="0:0:0.4"
                             AccelerationRatio="0.2" DecelerationRatio="0.8"/>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.1" To="1" Duration="0:0:0.4"
                             AccelerationRatio="0.2" DecelerationRatio="0.8"/>
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>
                <DoubleAnimation x:Name="AnimTranslateX"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             Duration="0:0:0.4"
                             AccelerationRatio="0.2" DecelerationRatio="0.8"/>
                <DoubleAnimation x:Name="AnimTranslateY"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             Duration="0:0:0.4"
                             AccelerationRatio="0.2" DecelerationRatio="0.8"/>
            </Storyboard>

            <!-- 分页按钮样式 -->
            <Style x:Key="PaginationButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#5a5a5a"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#7a7a7a"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                CornerRadius="3"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 当前页标签样式 -->
            <Style x:Key="CurrentPageTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="10,0"/>
            </Style>

            <!-- 报警类型颜色样式 -->
            <SolidColorBrush x:Key="DeviceAlarmColor" Color="#9C27B0"/>
            <SolidColorBrush x:Key="PhysiologicalAlarmColor" Color="#4CAF50"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#404042">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScaleTransform"/>
                <TranslateTransform x:Name="WindowTranslateTransform"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" BorderBrush="#2c2c2c" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource AlarmListTitle}" FontSize="17" Foreground="White" 
                           VerticalAlignment="Center" Margin="10,0,20,0" 
                           FontWeight="Bold" Grid.Column="0"/>

                    <Button Name="close" Style="{StaticResource IndexbuttonStyle2}" 
                        Click="close_Click" Grid.Column="2">
                        <Image Source="/IMG/new/close.png"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 数据表格区域 -->
            <Grid Grid.Row="1" Margin="10">
                <DataGrid x:Name="AlarmDataGrid"
                      Background="Transparent" 
                      Style="{StaticResource TransparentHeaderDataGridStyle}"
                      ItemsSource="{Binding AlarmItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      RowHeight="40">

                    <DataGrid.Columns>
                        <!-- 床号 -->
                        <DataGridTemplateColumn Width="0.5*">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{DynamicResource BedNumber}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="White" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BedNumber}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="#C5C8D0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 姓名 -->
                        <DataGridTemplateColumn Width="0.5*">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{DynamicResource PatientName}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="White" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PatientName}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="#C5C8D0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 报警类型 -->
                        <DataGridTemplateColumn Width="0.8*">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{DynamicResource AlarmType}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="White" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AlarmType}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="#C5C8D0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 参数 -->
                        <!--<DataGridTemplateColumn Width="0.6*">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{DynamicResource Parameter}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="White" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ParameterName}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="#C5C8D0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>-->

                        <!-- 当前值 -->
                        <!--<DataGridTemplateColumn Width="0.7*">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{DynamicResource CurrentValue}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="White" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CurrentValue, StringFormat={}{0:F1}}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="#C5C8D0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>-->

                        <!-- 设备型号 -->
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{DynamicResource DeviceModel}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="White" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeviceModel}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="#C5C8D0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 报警内容 -->
                        <DataGridTemplateColumn Width="2*">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{DynamicResource AlarmContent}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="White" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AlarmContent}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="#C5C8D0" Margin="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 报警等级 -->
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{DynamicResource AlarmLevel}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="White" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                                            CornerRadius="3" Padding="8,4">
                                        <TextBlock Text="{Binding AlarmLevel}" 
                                                   Foreground="White" 
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E03F3F"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AlarmLevel}" Value="警告">
                                                        <Setter Property="Background" Value="#E6A029"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AlarmLevel}" Value="轻微">
                                                        <Setter Property="Background" Value="#FFC107"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AlarmLevel}" Value="设备报警">
                                                        <Setter Property="Background" Value="#9C27B0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 报警时间 -->
                        <DataGridTemplateColumn Width="1.5*">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{DynamicResource AlarmTime}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="White" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AlarmTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="#C5C8D0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 分页控件 -->
            <Border Grid.Row="2" Background="#4a4a4a" Padding="10" Margin="10,5,10,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- 每页显示数量选择 -->
                    <TextBlock Text="{DynamicResource PageDisplay}" Style="{StaticResource CurrentPageTextStyle}"/>
                    <ComboBox Width="100" Height="30" 
                      SelectedValue="{Binding PageSize}" 
                      ItemsSource="{Binding PageSizes}" 
                      Style="{StaticResource StatusComboBoxStyle}" 
                      Background="#5a5a5a" 
                      Foreground="White"
                      TextElement.Foreground="White"
                      BorderBrush="#7a7a7a"/>
                    <!-- 分页按钮 -->
                    <Button Content="{DynamicResource FirstPage}" Style="{StaticResource PaginationButtonStyle}" 
                        Command="{Binding FirstPageCommand}" Margin="20,0,5,0"/>
                    <Button Content="{DynamicResource PreviousPage}" Style="{StaticResource PaginationButtonStyle}" 
                        Command="{Binding PreviousPageCommand}"/>

                    <TextBlock Text="{Binding CurrentPage}" Style="{StaticResource CurrentPageTextStyle}"/>
                    <TextBlock Text="/" Style="{StaticResource CurrentPageTextStyle}"/>
                    <TextBlock Text="{Binding TotalPages}" Style="{StaticResource CurrentPageTextStyle}"/>

                    <Button Content="{DynamicResource NextPage}" Style="{StaticResource PaginationButtonStyle}" 
                        Command="{Binding NextPageCommand}"/>
                    <Button Content="{DynamicResource LastPage}" Style="{StaticResource PaginationButtonStyle}" 
                        Command="{Binding LastPageCommand}" Margin="5,0,20,0"/>

                    <!-- 清除所有报警按钮 -->
                    <Button Content="{DynamicResource ClearAllAlarms}" Width="120" Height="30" Margin="40,0,0,0"
                        Background="#F44336" Foreground="White" FontWeight="Bold"
                        Command="{Binding ClearAllCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="3"
                                                BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
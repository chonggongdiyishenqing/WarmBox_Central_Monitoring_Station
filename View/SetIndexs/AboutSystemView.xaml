<UserControl x:Class="WarmBox_Central_Monitoring_Station.View.SetIndexs.AboutSystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WarmBox_Central_Monitoring_Station.View.SetIndexs"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.75*"></RowDefinition>
            <RowDefinition Height="10"></RowDefinition>
            <RowDefinition Height="0.75*"></RowDefinition>
            <RowDefinition Height="10"></RowDefinition>
            <RowDefinition Height="1.5*"></RowDefinition>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.5*"></RowDefinition>
                    <RowDefinition Height="7.5*"></RowDefinition>
                </Grid.RowDefinitions>
                <Border Background="Gray" Margin="10" Height="1" Grid.Row="0"/>
                <Grid Grid.Row="1" Margin="10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <Label Content="软件名称：" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" />
                        <Label Content="婴儿培养箱中央监护系统" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="White" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="0">
                        <Label Content="版本号：" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" />
                        <Label Content="V1.0.0.20260417" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="White" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="1">
                        <Label Content="许可证类型：" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" />
                        <Label Content="医疗设备专用授权" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="White" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="1">
                        <Label Content="发布日期：" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" />
                        <Label Content="2026年04月17日" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="White" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.5*"></RowDefinition>
                    <RowDefinition Height="7.5*"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel  Margin="10,10,10,0"  Grid.Row="0" Orientation="Horizontal">
                    <Image Source="/img/new/cy.png" Width="24" Height="24"></Image>
                    <Label Content="开发者信息" Foreground="White" FontWeight="Bold" FontSize="16"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="10,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <Label Content="开发单位：" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" />
                        <Label Content="戴维医疗器械股份有限公司" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="White" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="0">
                        <Label Content="官方网站：" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" />
                        <Label Content="www.david.com" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="White" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*"></RowDefinition>
                    <RowDefinition Height="8.5*"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel Margin="10,0,10,0" Grid.Row="0" Orientation="Horizontal">
                    <Image Source="/img/new/dp.png" Width="24" Height="24" VerticalAlignment="Center"/>
                    <Label Content="法律信息" Foreground="White" FontWeight="Bold" FontSize="16" 
                    VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.75*"></RowDefinition>
                        <RowDefinition Height="1"></RowDefinition>
                        <RowDefinition Height="1.3*"></RowDefinition>
                        <RowDefinition Height="1"></RowDefinition>
                        <RowDefinition Height="0.75*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Vertical" Grid.Row="0" >
                        <Label Content="版权所有 @2026戴维医疗器械股份有限公司保留所有权利" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"  Margin="0,0,0,5"/>
                        <Label Content="本软件受著作权法和国际版权公约包含，未经授权，不得以任何形式复制、传播本软件的任何部分" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="White"  />
                    </StackPanel>
                    <Border Background="Gray" Grid.Row="1"/>
                    <StackPanel Orientation="Vertical" Grid.Row="2" >
                        <Label Content="医疗设备注册信息" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"  Margin="0,0,0,5"/>
                        <Border Height="10"/>
                        <Label Content="医疗注册证号：国械注准20XXXXXX" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="White"  />
                        <Label Content="生产许可证号：X医械生产许可20XXXXXX号" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="White"  />
                    </StackPanel>
                    <Border Background="Gray" Grid.Row="3"/>
                    <StackPanel Orientation="Vertical" Grid.Row="4" >
                        <Label Content="免责声明" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"  Margin="0,0,0,5"/>
                        <Label Content="本系统仅供医疗专业人员使用。使用前请仔细阅读产品说明书，并按照规定操作。如有疑问，请联系技术支持" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="White"  />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

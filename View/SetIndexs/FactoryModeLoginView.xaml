<UserControl x:Class="WarmBox_Central_Monitoring_Station.View.SetIndexs.FactoryModeLoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WarmBox_Central_Monitoring_Station.View.SetIndexs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyStyle/Diystyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Image Source="/IMG/new/gj.png" Height="100" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel>
                    <TextBlock FontSize="26" Foreground="White" HorizontalAlignment="Center" Margin="0,50,0,10"
                               Text="{DynamicResource EngineeringMode}"/>
                    <TextBlock FontSize="18" Foreground="#686e7b" HorizontalAlignment="Center" Margin="0,10"
                               Text="{DynamicResource EngineeringModeWarning}" TextWrapping="WrapWithOverflow"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBox x:Name="PasswordTextBox" 
                        Width="200" 
                        Height="30" 
                        FontSize="18" 
                        Foreground="White" 
                        CaretBrush="White"
                        Background="Transparent" 
                        BorderBrush="White" 
                        BorderThickness="1"
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center"
                        Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        TextAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding VerifyCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="{DynamicResource Verify}" 
                            Style="{StaticResource IconButtonStyle_xq2}" 
                            Margin="10,10,0,10" 
                            Background="#dc4042"
                            Command="{Binding VerifyCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
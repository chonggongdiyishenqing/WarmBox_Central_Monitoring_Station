<UserControl x:Class="WarmBox_Central_Monitoring_Station.View.SetIndexs.PatientManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WarmBox_Central_Monitoring_Station.View.SetIndexs"
             xmlns:converters="clr-namespace:WarmBox_Central_Monitoring_Station.Converters"
             xmlns:vm="clr-namespace:WarmBox_Central_Monitoring_Station.ViewModel"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             x:Name="PatientManagementUserControl">
    <UserControl.Resources>
        <converters:BoolInverseConverter x:Key="BoolInverseConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <!-- 深色圆角文本框样式（只读 + 粗体） -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#3c3c3c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="2"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色圆角下拉框样式（白色文本 + 左侧间距） -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#3c3c3c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          Foreground="{TemplateBinding Foreground}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Border x:Name="Border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"/>
                                            <ContentPresenter x:Name="ContentPresenter"
                                                              Content="{TemplateBinding Content}"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                               Margin="12,4,0,4"
                                                              />
                                            <Path x:Name="Arrow"
                                                  Fill="White"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Slide"
                                   AllowsTransparency="True"
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                <Border Background="#2d2d2d"
                                        BorderBrush="#555555"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0">
                                    <ScrollViewer Margin="4"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#555555"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#404040"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>

        <!-- 性别分段选择器样式（边框可配置，选中背景 #6c6c6c） -->
        <Style x:Key="GenderSegmentStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#3c3c3c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#6c6c6c"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#4a4a4a"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Margin="10" BorderBrush="#555555" BorderThickness="1" CornerRadius="8" Background="#2a2a2a">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 线上区域：设备编号 -->
                    <Border Grid.Row="0" Margin="30,20,20,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center">
                                <Run Text="{DynamicResource DeviceNumber}"/><Run Text="："/>
                            </TextBlock>
                            <ComboBox Grid.Column="1" Margin="10,0,0,0"
                                      ItemsSource="{Binding DeviceList}"
                                      SelectedItem="{Binding SelectedDevice, UpdateSourceTrigger=PropertyChanged}"
                                      Foreground="White"
                                      SelectedValuePath="."
                                      DisplayMemberPath="."
                                      HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>

                    <!-- 分隔线 -->
                    <Border Grid.Row="1" Height="1" Background="#555555" Margin="20,0,20,10"/>

                    <!-- 线下区域：两列表单 -->
                    <Grid Grid.Row="2" Margin="30,20,30,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧列 -->
                        <StackPanel Grid.Column="0" Margin="0,0,40,0">
                            <!-- 病人编号 -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="#cccccc" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                    <Run Text="{DynamicResource PatientID}"/><Run Text="："/>
                                </TextBlock>
                                <TextBox Grid.Column="1" Text="{Binding PatientId, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- 性别：分段选择器（男/女） -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="#cccccc" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                    <Run Text="{DynamicResource Sex}"/><Run Text="："/>
                                </TextBlock>
                                <Border Grid.Column="1" Padding="4" Background="#3f3f3f" CornerRadius="6" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource GenderSegmentStyle}"
                                                      Content="{DynamicResource Male}"
                                                      BorderThickness="0"
                                                      IsEnabled="False"
                                                      IsChecked="{Binding IsMale, Converter={StaticResource BoolInverseConverter}, ConverterParameter=true, Mode=TwoWay}"/>
                                        <ToggleButton Style="{StaticResource GenderSegmentStyle}"
                                                      Content="{DynamicResource Female}"
                                                      BorderThickness="0"
                                                      IsEnabled="False"
                                                      IsChecked="{Binding IsMale, Converter={StaticResource BoolInverseConverter}, ConverterParameter=false, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 出生日期 -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="#cccccc" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                    <Run Text="{DynamicResource BirthDate}"/><Run Text="："/>
                                </TextBlock>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBox Width="55" Margin="0,0,6,0" Text="{Binding BirthYear}" HorizontalContentAlignment="Center"/>
                                    <TextBlock Text="年" Foreground="#cccccc" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Width="45" Margin="0,0,6,0" Text="{Binding BirthMonth}" HorizontalContentAlignment="Center"/>
                                    <TextBlock Text="月" Foreground="#cccccc" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Width="45" Text="{Binding BirthDay}" HorizontalContentAlignment="Center"/>
                                    <TextBlock Text="日" Foreground="#cccccc" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 胎龄 -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="#cccccc" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                    <Run Text="{DynamicResource GestationalAge}"/><Run Text="："/>
                                </TextBlock>
                                <TextBox Grid.Column="1" Text="{Binding GestationalAge}"/>
                            </Grid>

                            <!-- 体重 -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="#cccccc" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                    <Run Text="{DynamicResource Weight}"/><Run Text="："/>
                                </TextBlock>
                                <TextBox Grid.Column="1" Text="{Binding Weight}"/>
                            </Grid>

                            <!-- 身高 -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="#cccccc" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                    <Run Text="{DynamicResource Height}"/><Run Text="："/>
                                </TextBlock>
                                <TextBox Grid.Column="1" Text="{Binding Height}"/>
                            </Grid>

                            <!-- 日龄 -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="#cccccc" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                    <Run Text="{DynamicResource DayAge}"/><Run Text="："/>
                                </TextBlock>
                                <TextBox Grid.Column="1" Text="{Binding AgeDays}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 右侧列 -->
                        <StackPanel Grid.Column="1" Margin="40,0,0,0">
                            <!-- 姓名 -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="#cccccc" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                    <Run Text="{DynamicResource Name}"/><Run Text="："/>
                                </TextBlock>
                                <TextBox Grid.Column="1" Text="{Binding Name}"/>
                            </Grid>

                            <!-- 血型 -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="#cccccc" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                    <Run Text="{DynamicResource BloodType}"/><Run Text="："/>
                                </TextBlock>
                                <ComboBox Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                          IsEnabled="False"
                                          ItemsSource="{Binding BloodTypeList}"
                                          SelectedItem="{Binding BloodType}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="#555555">
                        <Button MinWidth="150" Width="150" HorizontalAlignment="Right" Margin="15,10" 
                           Content="{DynamicResource SyncPatientData}" Cursor="Hand" FontSize="13" FontWeight="Bold" 
                           Command="{Binding  StartSyncCommand }"
                           Foreground="WhiteSmoke" Background="#4A90E2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                        CornerRadius="4" Padding="10,5">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                    <!-- 同步加载弹窗（局部引入 HandyControl 样式） -->
                    <!-- 同步弹窗（局部引入 HandyControl 样式） -->
                    <Popup x:Name="SyncPopup" 
       IsOpen="{Binding IsSyncing}" 
       StaysOpen="False"
       Placement="Center"
       AllowsTransparency="True">
                        <Border Background="#2c2c2c" CornerRadius="8" Padding="30" Width="360"
            BorderBrush="#555555" BorderThickness="1">
                            <Border.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                                        <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </Border.Resources>
                            <StackPanel>
                                <!-- 加载动画，同步运行时可见 -->
                                <hc:CircleProgressBar Width="80" Height="80" 
                                  ArcThickness="8"
                                  IsIndeterminate="True"
                                  Margin="0,10,0,20"
                                  Foreground="#4A90E2"
                                  Visibility="{Binding IsSyncRunning, Converter={StaticResource BoolToVis}}" />

                                <!-- 提示文字 -->
                                <TextBlock Text="{Binding SyncResultMessage, TargetNullValue='开始同步'}" 
                       Foreground="White" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10"
                       TextWrapping="Wrap" TextAlignment="Center" />

                                <!-- 按钮区域 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <!-- 开始同步 / 确定 按钮 -->
                                    <Button Width="100" Height="36" Margin="10,0"
                        Background="#4A90E2" Foreground="White" Cursor="Hand"
                        Command="{Binding CancelSyncCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="6" Padding="10,5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Content>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{DynamicResource StartSync}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSyncCompleted}" Value="True">
                                                                <Setter Property="Text" Value="{DynamicResource Confirm}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button.Content>
                                    </Button>

                                    <!-- 取消按钮 -->
                                    <Button Width="100" Height="36" Margin="10,0"
                        Background="#555555" Foreground="White" Cursor="Hand"
                        Command="{Binding CancelSyncCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="6" Padding="10,5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="{DynamicResource Cancel}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>